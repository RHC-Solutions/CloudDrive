<Project>

  <!--
    Shared across every project. Version, branding and analysis settings live here so a release
    bumps one number instead of eight, and so a new project cannot quietly opt out of nullability
    or the platform-compatibility analyzer.
  -->
  <PropertyGroup>
    <Version>1.0.8</Version>
    <Product>CloudDrive</Product>
    <Company>RHC Solutions</Company>
    <Authors>RHC Solutions</Authors>
    <Copyright>© RHC Solutions. https://rhcsolutions.com/</Copyright>
    <PackageProjectUrl>https://rhcsolutions.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RHC-Solutions/CloudDrive</RepositoryUrl>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      InvariantGlobalization is deliberately NOT set, and this is not a style preference.

      Setting it true made the tray app crash on startup, every time, on the first window it opened:

        XamlParseException: Initialization of 'System.Windows.Controls.ListView' threw an exception
        inner: InvalidOperationException: Cannot find non-neutral culture related to 'en-us'
               at System.Windows.Markup.XmlLanguage.GetSpecificCulture()
               at System.Windows.Data.BindingExpressionBase.GetCulture()

      WPF resolves a specific culture for every data binding, and in globalization-invariant mode there
      is no culture data to resolve against, so any Binding inside a Style or DataTrigger throws while
      the XAML loads. It is fundamentally incompatible with WPF, and the cost of the flag — a smaller
      self-contained publish, since ICU is dropped — buys nothing worth an application that cannot start.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      CA1416 (platform compatibility) is the analyzer that catches calling a Windows-10-1709 API on
      a build that claims to support Server 2016. Given that CloudDrive deliberately targets a range
      spanning both, it is an error rather than a warning.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA1416;CS8600;CS8602;CS8603;CS8618</WarningsAsErrors>
  </PropertyGroup>

</Project>
