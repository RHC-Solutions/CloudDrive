{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/auto-commit.ps1 -QuietSeconds 0",
            "shell": "powershell",
            "timeout": 120,
            "statusMessage": "Committing and pushing..."
          }
        ]
      }
    ]
  }
}
