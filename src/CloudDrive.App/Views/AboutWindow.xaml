<Window x:Class="CloudDrive.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="About CloudDrive" Height="460" Width="480"
        Icon="/Assets/clouddrive.ico"
        Background="{StaticResource CD.Brush.BgPrimary}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="/Assets/logo.png" Width="56" Height="56" Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CloudDrive" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource CD.Subtitle}" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Open on GitHub" Click="OnGitHub" Margin="0,0,8,0"/>
            <Button Content="Close" Click="OnClose" Style="{StaticResource CD.Button.Accent}" MinWidth="88"/>
        </StackPanel>

        <StackPanel>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CD.Subtitle}" FontSize="12"
                       Text="Mount Wasabi, AWS S3, Backblaze B2, Hetzner, OneDrive, Google Drive, SFTP, SMB, FTP, WebDAV and any S3-compatible service as native Windows drives."/>

            <Border Background="{StaticResource CD.Brush.BgSecondary}"
                    BorderBrush="{StaticResource CD.Brush.Border}" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="ServiceText" Style="{StaticResource CD.Subtitle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SystemText" Style="{StaticResource CD.Subtitle}" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBlock x:Name="RcloneText" Style="{StaticResource CD.Subtitle}" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBlock x:Name="WinFspText" Style="{StaticResource CD.Subtitle}" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBlock x:Name="OnDemandText" Style="{StaticResource CD.Subtitle}" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CD.Subtitle}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="Built on rclone and WinFsp. MIT licensed."/>
            <TextBlock Style="{StaticResource CD.Subtitle}" Margin="0,4,0,0"
                       Text="© RHC Solutions · rhcsolutions.com"/>
        </StackPanel>
    </DockPanel>
</Window>
