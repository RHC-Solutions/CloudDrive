<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    No OS-version-specific TFM, and no reference to CloudDrive.CloudFiles. The service must run on
    Server 2016 and on Server Core, and CloudFiles needs the Cloud Files API that neither has.
    Keeping the dependency out means a Server 2016 install cannot even load the code that would fail
    there.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>CloudDrive.Service</AssemblyName>
    <RootNamespace>CloudDrive.Service</RootNamespace>
    <Product>CloudDrive mount service</Product>
    <UserSecretsId>clouddrive-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudDrive.Core\CloudDrive.Core.csproj" />
    <ProjectReference Include="..\CloudDrive.Ipc\CloudDrive.Ipc.csproj" />
    <ProjectReference Include="..\CloudDrive.Notifications\CloudDrive.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

</Project>
